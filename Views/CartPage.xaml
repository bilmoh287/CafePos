<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CafePos.Models"
             xmlns:viewmodels="clr-namespace:CafePos.ViewModels"
             x:Class="CafePos.Views.CartPage"
             x:DataType="viewmodels:CartViewModel"
             x:Name="CartPageName"
             Title="Current Order"
             BackgroundColor="#F4F5F7">

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="16">

        <!-- Header Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Current Order Summary"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />
                <Label Text="Review line items, adjust quantities, and check total."
                       FontSize="13"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Clear Order"
                    Command="{Binding ClearCartCommand}"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    Padding="16,0"
                    IsVisible="{Binding HasItems}" />
        </Grid>

        <!-- Empty State View -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsEmpty}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Border StrokeShape="RoundRectangle 40"
                    BackgroundColor="#E5E7EB"
                    StrokeThickness="0"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center">
                <Label Text="🛒"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <Label Text="Your Cart is Empty"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#4B5563"
                   HorizontalOptions="Center" />
            <Label Text="Tap products in the catalog to add them to your order."
                   FontSize="14"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Active Order Content Grid (Line Items + Summary Card) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,340"
              ColumnSpacing="16"
              IsVisible="{Binding HasItems}">

            <!-- Line Items CollectionView -->
            <CollectionView Grid.Column="0"
                            ItemsSource="{Binding Items}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Border StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                BackgroundColor="White"
                                Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="16"
                                  VerticalOptions="Center">

                                <!-- Product Info -->
                                <VerticalStackLayout Grid.Column="0"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Product.Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Product.Category}"
                                               FontSize="12"
                                               TextColor="#2563EB"
                                               FontAttributes="Bold" />
                                        <Label Text="•" TextColor="#9CA3AF" FontSize="12" />
                                        <Label Text="{Binding UnitPrice, StringFormat='${0:F2} each'}"
                                               FontSize="12"
                                               TextColor="#6B7280" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Quantity Adjustment Controls -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        Stroke="#D1D5DB"
                                        BackgroundColor="#F9FAFB"
                                        Padding="2"
                                        VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="0">
                                        <Button Text="-"
                                                Command="{Binding BindingContext.DecreaseQuantityCommand, Source={x:Reference CartPageName}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#374151"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0" />
                                        
                                        <Label Text="{Binding Quantity}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937"
                                               WidthRequest="36"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />

                                        <Button Text="+"
                                                Command="{Binding BindingContext.IncreaseQuantityCommand, Source={x:Reference CartPageName}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#374151"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Total Price for Line Item -->
                                <Label Grid.Column="2"
                                       Text="{Binding TotalPrice, StringFormat='${0:F2}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#059669"
                                       WidthRequest="80"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />

                                <!-- Remove Button -->
                                <Button Grid.Column="3"
                                        Text="✕"
                                        Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference CartPageName}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#EF4444"
                                        CornerRadius="16"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Order Financial Summary Card -->
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="20"
                    VerticalOptions="Start">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Financial Breakdown"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />

                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <!-- Subtotal -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Items Subtotal" FontSize="14" TextColor="#6B7280" />
                        <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                    </Grid>

                    <!-- Sales Tax -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Sales Tax (8.5%)" FontSize="14" TextColor="#6B7280" />
                        <Label Grid.Column="1" Text="{Binding Tax, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <!-- Grand Total -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Grand Total" FontSize="18" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="#059669" VerticalOptions="Center" />
                    </Grid>

                    <!-- Checkout Button -->
                    <Button Text="Proceed to Payment"
                            Clicked="OnProceedToPaymentClicked"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="48"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
