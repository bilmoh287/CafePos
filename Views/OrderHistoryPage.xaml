<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CafePos.Models"
             xmlns:viewmodels="clr-namespace:CafePos.ViewModels"
             x:Class="CafePos.Views.OrderHistoryPage"
             x:DataType="viewmodels:OrderHistoryViewModel"
             x:Name="HistoryPageName"
             Title="Order History"
             BackgroundColor="#F4F5F7">

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="16">

        <!-- Top Header & Refresh Button -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Transaction History"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />
                <Label Text="Review completed orders, sales tax details, and historical receipts."
                       FontSize="13"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding LoadOrdersCommand}"
                    BackgroundColor="#3B82F6"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    Padding="16,0" />
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">

            <!-- Loading State -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="#3B82F6"
                               HeightRequest="48"
                               WidthRequest="48" />

            <!-- Empty State View -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Border StrokeShape="RoundRectangle 40"
                        BackgroundColor="#E5E7EB"
                        StrokeThickness="0"
                        HeightRequest="80"
                        WidthRequest="80"
                        HorizontalOptions="Center">
                    <Label Text="📋"
                           FontSize="36"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="No Completed Orders"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#4B5563"
                       HorizontalOptions="Center" />
                <Label Text="Completed customer sales will be saved and displayed here."
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Error State View -->
            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="8">
                <Label Text="{Binding ErrorMessage}"
                       FontSize="14"
                       TextColor="#EF4444"
                       HorizontalOptions="Center" />
                <Button Text="Retry"
                        Command="{Binding LoadOrdersCommand}"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        CornerRadius="8"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Orders Collection Grid -->
            <CollectionView ItemsSource="{Binding Orders}"
                            IsVisible="{Binding HasOrders}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                BackgroundColor="White"
                                Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="16"
                                  VerticalOptions="Center">

                                <!-- Order Number & Date -->
                                <VerticalStackLayout Grid.Column="0"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding OrderNumber}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <Label Text="{Binding OrderDate.LocalDateTime, StringFormat='{0:MMM dd, yyyy  h:mm tt}'}"
                                           FontSize="12"
                                           TextColor="#6B7280" />
                                </VerticalStackLayout>

                                <!-- Payment Method Badge -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="#F3F4F6"
                                        StrokeThickness="1"
                                        Stroke="#D1D5DB"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding PaymentMethod, StringFormat='💳 {0}'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#374151" />
                                </Border>

                                <!-- Grand Total -->
                                <VerticalStackLayout Grid.Column="2"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End"
                                                     Spacing="2"
                                                     WidthRequest="100">
                                    <Label Text="{Binding GrandTotal, StringFormat='${0:F2}'}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#059669"
                                           HorizontalOptions="End" />
                                    <Label Text="{Binding Items.Count, StringFormat='{0} items'}"
                                           FontSize="12"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>

                                <!-- View Receipt Button -->
                                <Button Grid.Column="3"
                                        Text="View Receipt"
                                        Command="{Binding BindingContext.SelectOrderCommand, Source={x:Reference HistoryPageName}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        CornerRadius="8"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Detailed Receipt Modal Overlay -->
            <Grid IsVisible="{Binding IsShowingReceipt}"
                  BackgroundColor="#80000000"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        WidthRequest="480"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="24">
                    <VerticalStackLayout Spacing="16">

                        <!-- Modal Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="CafePos Order Receipt"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="{Binding SelectedOrder.OrderNumber}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="✕"
                                    Command="{Binding CloseReceiptCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#6B7280"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#E5E7EB" />

                        <!-- Transaction Metadata -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedOrder.OrderDate.LocalDateTime, StringFormat='Date: {0:MMM dd, yyyy  h:mm tt}'}"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedOrder.PaymentMethod, StringFormat='Payment: {0}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                        </Grid>

                        <!-- Order Items Breakdown List -->
                        <CollectionView ItemsSource="{Binding SelectedOrder.Items}"
                                        HeightRequest="180">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding ProductName}" FontSize="13" FontAttributes="Bold" TextColor="#1F2937" />
                                            <Label Text="{Binding UnitPrice, StringFormat='${0:F2} each'}" FontSize="11" TextColor="#9CA3AF" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="13" TextColor="#6B7280" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:F2}'}" FontSize="13" FontAttributes="Bold" TextColor="#374151" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView HeightRequest="1" Color="#E5E7EB" />

                        <!-- Financial Totals -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Items Subtotal" FontSize="13" TextColor="#6B7280" />
                                <Label Grid.Column="1" Text="{Binding SelectedOrder.Subtotal, StringFormat='${0:F2}'}" FontSize="13" FontAttributes="Bold" TextColor="#374151" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Sales Tax (8.5%)" FontSize="13" TextColor="#6B7280" />
                                <Label Grid.Column="1" Text="{Binding SelectedOrder.Tax, StringFormat='${0:F2}'}" FontSize="13" FontAttributes="Bold" TextColor="#374151" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Label Grid.Column="0" Text="Grand Total" FontSize="16" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding SelectedOrder.GrandTotal, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="#059669" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Close Button -->
                        <Button Text="Close Receipt"
                                Command="{Binding CloseReceiptCommand}"
                                BackgroundColor="#3B82F6"
                                TextColor="White"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
