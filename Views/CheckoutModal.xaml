<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CafePos.Models"
             xmlns:viewmodels="clr-namespace:CafePos.ViewModels"
             x:Class="CafePos.Views.CheckoutModal"
             x:DataType="viewmodels:CheckoutViewModel"
             x:Name="ThisModal"
             Title="Checkout"
             BackgroundColor="#80000000">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="20">
        
        <Border StrokeShape="RoundRectangle 16"
                BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="460"
                Padding="24">
            <VerticalStackLayout Spacing="18">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Complete Transaction"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />
                    <Button Grid.Column="1"
                            Text="✕"
                            Clicked="OnCancelClicked"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            FontAttributes="Bold"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0" />
                </Grid>

                <BoxView HeightRequest="1" Color="#E5E7EB" />

                <!-- Payment Summary Card -->
                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="#F9FAFB"
                        StrokeThickness="1"
                        Stroke="#E5E7EB"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Items Count" TextColor="#6B7280" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding TotalItemCount}" TextColor="#1F2937" FontAttributes="Bold" FontSize="13" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Sales Tax (8.5%)" TextColor="#6B7280" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding Tax, StringFormat='${0:F2}'}" TextColor="#1F2937" FontAttributes="Bold" FontSize="13" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="Amount Due" TextColor="#1F2937" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" TextColor="#059669" FontAttributes="Bold" FontSize="22" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Payment Method Selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Select Payment Method"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Cash Option -->
                        <Button Grid.Column="0"
                                Text="💵 Cash"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static models:PaymentMethod.Cash}"
                                HeightRequest="48"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                FontSize="15"
                                BackgroundColor="#2563EB"
                                TextColor="White" />

                        <!-- Card Option -->
                        <Button Grid.Column="1"
                                Text="💳 Card"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static models:PaymentMethod.Card}"
                                HeightRequest="48"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                FontSize="15"
                                BackgroundColor="#2563EB"
                                TextColor="White" />
                    </Grid>

                    <Label Text="{Binding SelectedPaymentMethod, StringFormat='Selected: {0}'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#2563EB"
                           HorizontalOptions="Center"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsProcessing}"
                                   IsVisible="{Binding IsProcessing}"
                                   Color="#10B981"
                                   HorizontalOptions="Center"
                                   HeightRequest="36" />

                <!-- Error Message -->
                <Label IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       TextColor="#EF4444"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Clicked="OnCancelClicked"
                            BackgroundColor="#E5E7EB"
                            TextColor="#374151"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="44" />

                    <Button Grid.Column="1"
                            Text="Pay &amp; Save Order"
                            Command="{Binding ProcessCheckoutCommand}"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="44" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
