<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CafePos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CafePos.Views"
    Title="CafePos">

    <TabBar>
        <Tab Title="Catalog" Icon="dotnet_bot.png">
            <ShellContent
                Title="Products"
                ContentTemplate="{DataTemplate views:ProductsPage}"
                Route="ProductsPage" />
        </Tab>
        <Tab Title="Current Order" Icon="dotnet_bot.png">
            <ShellContent
                Title="Cart"
                ContentTemplate="{DataTemplate views:CartPage}"
                Route="CartPage" />
        </Tab>
        <Tab Title="History" Icon="dotnet_bot.png">
            <ShellContent
                Title="Orders"
                ContentTemplate="{DataTemplate views:OrderHistoryPage}"
                Route="OrderHistoryPage" />
        </Tab>
    </TabBar>

</Shell>
